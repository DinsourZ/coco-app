{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://coco.local/schemas/tool_call.schema.json",
  "title": "CoCo AI tool call",
  "type": "object",
  "required": ["tool", "args"],
  "properties": {
    "tool": {
      "enum": ["web_search", "open_url", "fetch_page_text", "summarize_text",
               "device_motion", "device_face", "device_beep",
               "list_project_files", "read_project_file",
               "run_shell", "write_project_file", "git_commit", "install_package"]
    },
    "args": { "type": "object" },
    "category": { "enum": ["safe", "approval", "blocked"] }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": { "properties": { "tool": { "const": "device_motion" } } },
      "then": {
        "properties": {
          "args": {
            "type": "object",
            "required": ["action"],
            "properties": {
              "action": { "enum": ["forward", "backward", "left", "right", "stop",
                                    "head_left", "head_center", "head_right"] },
              "duration_ms": { "type": "integer", "minimum": 1, "maximum": 1000 },
              "speed": { "type": "number", "minimum": 0, "maximum": 0.5 },
              "device_id": { "type": "string", "minLength": 1, "maxLength": 64 }
            },
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": { "properties": { "tool": { "const": "run_shell" } } },
      "then": {
        "properties": {
          "args": {
            "type": "object",
            "required": ["command"],
            "properties": {
              "command": { "type": "string", "minLength": 1, "maxLength": 2000 },
              "cwd": { "type": "string" }
            },
            "additionalProperties": false
          }
        }
      }
    }
  ]
}
