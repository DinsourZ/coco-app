{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://coco.local/schemas/audio_cancel.schema.json",
  "title": "CoCo device audio.cancel (backend → device)",
  "description": "Cancel an in-flight or queued audio.play. Must be idempotent: unknown audio_id still yields a safe audio.result (cancelled/skipped), never motion side effects.",
  "type": "object",
  "properties": {
        "session_nonce": { "type": "string", "minLength": 16, "maxLength": 64, "pattern": "^[A-Za-z0-9_-]+$" },
        "generation": { "type": "integer", "minimum": 1, "maximum": 4294967295 },
        "protocol_version": { "const": "1" },
            "type": { "const": "audio.cancel" },
    "command_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9._:-]+$"
    },
    "audio_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9._:-]+$"
    },
    "reason": {
      "enum": [
        "user_stop",
        "timeout",
        "new_audio",
        "device_shutdown",
        "safety_stop"
      ]
    },
    "created_at": {
      "type": "number", "minimum": 0, "maximum": 253402300799
    }
  },
  "required": ["type", "command_id", "audio_id", "reason"],
  "additionalProperties": false
}
