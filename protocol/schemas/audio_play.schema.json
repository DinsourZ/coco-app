  "title": "CoCo device audio.play (backend → device)",
  "description": "Device audio play command, independent of device.command motion messages. No motion action fields are allowed. Firmware accepts bounded inline PCM16/WAV, finite stream_ref PCM16 transfers, and capability-gated live_stream_ref PCM16 transfers with application-level backpressure; pack assets still use local tone bring-up, and compressed decode remains future work.",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "session_nonce": { "type": "string", "minLength": 16, "maxLength": 64, "pattern": "^[A-Za-z0-9_-]+$" },
        "generation": { "type": "integer", "minimum": 1, "maximum": 4294967295 },
        "protocol_version": { "const": "1" },
                "type": {
          "const": "audio.play"
        },
        "command_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9._:-]+$"
        },
        "audio_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9._:-]+$"
        },
        "source_type": {
          "const": "inline_base64"
        },
        "mime_type": {
          "enum": [
            "audio/wav",
            "audio/mpeg",
            "audio/ogg",
            "audio/pcm"
          ]
        },
        "sample_rate_hz": {
          "type": "integer",
          "minimum": 8000,
          "maximum": 48000
        },
        "channels": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2
        },
        "duration_ms": {
          "type": "integer",
          "minimum": 1,
          "maximum": 30000
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 262144
        },
        "data_base64": {
          "type": "string",
          "minLength": 1,
          "maxLength": 360000,
          "pattern": "^[A-Za-z0-9+/]+=*$"
        },
        "text_hint": {
          "type": "string",
          "maxLength": 512
        },
        "locale": {
          "type": "string",
          "minLength": 2,
          "maxLength": 16,
          "pattern": "^[A-Za-z]{2,3}(-[A-Za-z0-9]{2,8})?$"
        },
        "voice_id": {
          "type": "string",
          "maxLength": 64
        },
        "interruptible": {
          "type": "boolean"
        },
        "deadline_ms": {
          "type": "integer",
          "minimum": 1,
          "maximum": 60000
        },
        "created_at": {
          "type": "number",
          "minimum": 0,
          "maximum": 253402300799
        }
      },
      "required": [
        "type",
        "command_id",
        "audio_id",
        "source_type",
        "mime_type",
        "duration_ms",
        "size_bytes",
        "data_base64"
