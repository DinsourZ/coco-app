{
  "name": "coco-app",
  "version": "0.1.0",
  "private": true,
  "description": "CoCo App — Native Android & iOS companion client for CoCo OS",
  "license": "MIT",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "export:native": "expo export --platform android --platform ios --no-bytecode --output-dir dist",
    "export:native:hermes": "expo export --platform android --platform ios --output-dir dist",
    "secret-scan": "node scripts/secret_scan.mjs",
    "verify": "npm run typecheck && npm run test && npm run secret-scan && npm run export:native"
  },
  "dependencies": {
    "expo": "~52.0.49",
    "expo-asset": "~11.0.5",
    "expo-clipboard": "~7.0.1",
    "expo-status-bar": "~2.0.1",
    "qrcode": "1.5.4",
    "react": "18.3.1",
    "react-native": "0.76.9",
    "react-native-safe-area-context": "4.12.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "~18.3.12",
    "typescript": "~5.5.3",
    "vitest": "^2.1.8"
  }
}
