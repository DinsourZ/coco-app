{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": false,
    "moduleResolution": "bundler",
    "baseUrl": ".",
    "paths": {
      "@coco/protocol": ["packages/protocol/src/index.ts"],
      "@coco/protocol/*": ["packages/protocol/src/*"],
      "@coco/api-client": ["packages/api-client/src/index.ts"],
      "@coco/api-client/*": ["packages/api-client/src/*"]
    }
  },
  "include": [
    "index.ts",
    "src/**/*.ts",
    "src/**/*.tsx",
    "packages/**/*.ts",
    "tests/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    ".expo"
  ]
}
